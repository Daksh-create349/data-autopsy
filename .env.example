# Data Autopsy Configuration Environment Variables

# Maximum upload file size in Megabytes (MB)
DATA_AUTOPSY_MAX_FILE_SIZE_MB=100

# Maximum rows to profile in deep mode (0 for unlimited)
DATA_AUTOPSY_MAX_ROWS_DEEP_PROFILE=500000

# Local Lightweight Qwen LLM Configuration (strictly local via Ollama - no data sent to external cloud)
# Allowed lightweight models: qwen2.5:1.5b (default), qwen2.5:0.5b (minimal resources)
# Never default or configure heavy 7B/14B models.
QWEN_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
